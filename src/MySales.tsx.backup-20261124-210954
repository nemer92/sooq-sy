
import { useCallback, useEffect, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";
import { supabase } from "./lib/supabase";
import DeliveryRequestModal from "./DeliveryRequestModal";
import {
  ArrowRight,
  ShoppingBag,
  Clock,
  CheckCircle,
  XCircle,
  PackageCheck,
  Star,
  MessageCircle,
  RefreshCw,
  CalendarDays,
  UserRound,
  Tag,
  ChevronLeft,
  Truck,
} from "lucide-react";

type DeliveryPrice = {
  id: string;
  amount: number;
  currency: string;
  status: string;
  created_at: string;
};

type CustomerDelivery = {
  request: {
    id: string;
    sale_request_id: string;
    status: string;
    delivery_fee: number | null;
    item_currency: string;
    payment_method: string;
    created_at: string;
  };
  driver: {
    id: string;
    display_name: string | null;
    avatar_url: string | null;
  };
  price_history: DeliveryPrice[];
};

type SaleRequest = {
  id: string;
  ad_id: string;
  buyer_id: string;
  seller_id: string;
  conversation_id: string | null;
  ad_title: string;
  agreed_price: number;
  currency: string;
  status: string;
  buyer_note: string | null;
  seller_note: string | null;
  created_at: string;
  completed_at: string | null;
  public_code?: number | null;
  other_name?: string;
  other_avatar?: string | null;
  already_reviewed?: boolean;
};

export default function MySales() {
  const [searchParams] = useSearchParams();
  const targetRequestId = searchParams.get("request_id");

  const [requests, setRequests] = useState<SaleRequest[]>([]);
  const [userId, setUserId] = useState("");
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState("");
  const [activeTab, setActiveTab] = useState<"incoming" | "outgoing">("incoming");
  const [message, setMessage] = useState("");
  const [reviewRequest, setReviewRequest] = useState<SaleRequest | null>(null);
  const [deliveryRequest, setDeliveryRequest] = useState<SaleRequest | null>(null);
  const [deliveryRecords, setDeliveryRecords] = useState<CustomerDelivery[]>([]);
  const [rating, setRating] = useState(5);
  const [communicationRating, setCommunicationRating] = useState(5);
  const [credibilityRating, setCredibilityRating] = useState(5);
  const [descriptionRating, setDescriptionRating] = useState(5);
  const [behaviorRating, setBehaviorRating] = useState(5);
  const [reviewComment, setReviewComment] = useState("");

  const loadRequests = useCallback(async () => {
    setLoading(true);
    setMessage("");

    try {
      const {
        data: { user },
        error: userError,
      } = await supabase.auth.getUser();

      if (userError) throw userError;

      if (!user) {
        setUserId("");
        setRequests([]);
        return;
      }

      setUserId(user.id);

      const { data: deliveryData, error: deliveryError } =
        await supabase.rpc("get_my_customer_delivery_requests");

      if (deliveryError) throw deliveryError;

      setDeliveryRecords(
        Array.isArray(deliveryData)
          ? (deliveryData as CustomerDelivery[])
          : []
      );

      const { data, error } = await supabase
        .from("sale_requests")
        .select("*")
        .or(`buyer_id.eq.${user.id},seller_id.eq.${user.id}`)
        .order("created_at", { ascending: false });

      if (error) throw error;

      const rows = (data || []) as SaleRequest[];

      const otherIds = [
        ...new Set(
          rows.map((request) =>
            request.buyer_id === user.id
              ? request.seller_id
              : request.buyer_id
          )
        ),
      ];

      const adIds = [...new Set(rows.map((request) => request.ad_id))];

      const [profilesResult, adsResult, reviewsResult] = await Promise.all([
        otherIds.length
          ? supabase
              .from("profiles")
              .select("id, display_name, avatar_url")
              .in("id", otherIds)
          : Promise.resolve({ data: [], error: null } as any),

        adIds.length
          ? supabase
              .from("ads")
              .select("id, public_code")
              .in("id", adIds)
          : Promise.resolve({ data: [], error: null } as any),

        supabase
          .from("seller_reviews")
          .select("sale_request_id")
          .eq("reviewer_id", user.id),
      ]);

      if (profilesResult.error) throw profilesResult.error;
      if (adsResult.error) throw adsResult.error;
      if (reviewsResult.error) throw reviewsResult.error;

      const profileMap = new Map(
        (profilesResult.data || []).map((profile: any) => [
          profile.id,
          profile,
        ])
      );

      const adMap = new Map<string, number | null>(
        (adsResult.data || []).map((ad: any) => [
          ad.id,
          ad.public_code == null ? null : Number(ad.public_code),
        ])
      );

      const reviewedIds = new Set(
        (reviewsResult.data || []).map(
          (review: any) => review.sale_request_id
        )
      );

      const enriched = rows.map((request) => {
        const otherId =
          request.buyer_id === user.id
            ? request.seller_id
            : request.buyer_id;

        const profile: any = profileMap.get(otherId);

        return {
          ...request,
          other_name: profile?.display_name || "مستخدم Sooq.sy",
          other_avatar: profile?.avatar_url || null,
          public_code: adMap.get(request.ad_id) ?? null,
          already_reviewed: reviewedIds.has(request.id),
        };
      });

      setRequests(enriched);
    } catch (error: any) {
      console.error("خطأ تحميل طلبات البيع والشراء:", error);
      setMessage(error?.message || "تعذر تحميل الطلبات.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadRequests();
  }, [loadRequests]);

  useEffect(() => {
    if (!targetRequestId || !userId || requests.length === 0) return;

    const target = requests.find(
      (request) => request.id === targetRequestId
    );

    if (!target) return;

    setActiveTab(
      target.seller_id === userId ? "incoming" : "outgoing"
    );
  }, [targetRequestId, userId, requests]);

  useEffect(() => {
    if (!targetRequestId || !userId || requests.length === 0) return;

    const target = requests.find(
      (request) => request.id === targetRequestId
    );

    if (!target) return;

    const correctTab =
      target.seller_id === userId ? "incoming" : "outgoing";

    if (activeTab !== correctTab) return;

    const timer = window.setTimeout(() => {
      const card = document.getElementById(
        `sale-request-${targetRequestId}`
      );

      card?.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });
    }, 150);

    return () => window.clearTimeout(timer);
  }, [targetRequestId, requests, activeTab, userId]);

  async function runAction(
    requestId: string,
    action: "accept" | "reject" | "delivered" | "received"
  ) {
    const confirmationMessages = {
      accept: "هل تريد قبول طلب الشراء؟",
      reject: "هل تريد رفض طلب الشراء؟",
      delivered: "هل تؤكد أنك سلّمت السلعة للمشتري؟",
      received: "هل تؤكد أنك استلمت السلعة؟ سيتم إغلاق الإعلان كمباع.",
    };

    const confirmed = await window.sooqConfirm(
      confirmationMessages[action]
    );

    if (!confirmed) return;

    setActionLoading(requestId);
    setMessage("");

    try {
      let result;

      if (action === "accept" || action === "reject") {
        result = await supabase.rpc("respond_sale_request", {
          p_request_id: requestId,
          p_action: action,
          p_note: null,
        });
      } else if (action === "delivered") {
        result = await supabase.rpc("mark_sale_delivered", {
          p_request_id: requestId,
        });
      } else {
        result = await supabase.rpc("confirm_sale_received", {
          p_request_id: requestId,
        });
      }

      if (result.error) throw result.error;

      await window.alert("تم تنفيذ العملية بنجاح.");
      await loadRequests();
    } catch (error: any) {
      console.error("خطأ تنفيذ طلب البيع:", error);
      setMessage(error?.message || "تعذر تنفيذ العملية.");
    } finally {
      setActionLoading("");
    }
  }

  async function respondToDeliveryPrice(
    deliveryId: string,
    accept: boolean
  ) {
    const confirmed = await window.sooqConfirm(
      accept
        ? "هل توافق على أجرة التوصيل المقترحة من العامل؟"
        : "هل تريد رفض أجرة التوصيل المقترحة؟"
    );

    if (!confirmed) return;

    setActionLoading(deliveryId);
    setMessage("");

    try {
      const { error } = await supabase.rpc("respond_delivery_price", {
        p_request_id: deliveryId,
        p_accept: accept,
      });

      if (error) throw error;

      await window.alert(
        accept
          ? "تمت الموافقة على أجرة التوصيل بنجاح."
          : "تم رفض الأجرة وإبلاغ عامل التوصيل."
      );

      await loadRequests();
    } catch (error: any) {
      console.error("Delivery price response error:", error);
      setMessage(error?.message || "تعذر إرسال ردك على أجرة التوصيل.");
    } finally {
      setActionLoading("");
    }
  }

  async function submitReview() {
    if (!reviewRequest) return;

    setActionLoading(reviewRequest.id);
    setMessage("");

    try {
      const { error } = await supabase.rpc("create_seller_review", {
        p_sale_request_id: reviewRequest.id,
        p_rating: rating,
        p_communication_rating: communicationRating,
        p_credibility_rating: credibilityRating,
        p_description_rating: descriptionRating,
        p_behavior_rating: behaviorRating,
        p_comment: reviewComment.trim() || null,
      });

      if (error) throw error;

      setReviewRequest(null);
      setReviewComment("");
      await window.alert("شكراً لك، تم إرسال تقييمك بنجاح.");
      await loadRequests();
    } catch (error: any) {
      console.error("خطأ إرسال التقييم:", error);
      setMessage(error?.message || "تعذر إرسال التقييم.");
    } finally {
      setActionLoading("");
    }
  }

  function statusLabel(status: string) {
    const labels: Record<string, string> = {
      pending: "بانتظار رد البائع",
      accepted: "تم قبول الطلب",
      rejected: "تم رفض الطلب",
      seller_marked_sold: "بانتظار تأكيد المشتري",
      completed: "تم البيع بنجاح",
      cancelled: "ملغي",
    };

    return labels[status] || status;
  }

  function statusColor(status: string) {
    if (status === "completed")
      return "bg-emerald-50 text-emerald-700 border-emerald-100";

    if (status === "rejected" || status === "cancelled")
      return "bg-rose-50 text-rose-700 border-rose-100";

    if (status === "pending")
      return "bg-amber-50 text-amber-700 border-amber-100";

    return "bg-blue-50 text-blue-700 border-blue-100";
  }

  function statusIcon(status: string) {
    if (status === "completed") return <CheckCircle size={14} />;
    if (status === "rejected" || status === "cancelled")
      return <XCircle size={14} />;
    if (status === "pending") return <Clock size={14} />;
    return <PackageCheck size={14} />;
  }

  function renderStars(
    value: number,
    onChange: (value: number) => void
  ) {
    return (
      <div className="flex flex-row-reverse justify-end gap-1.5">
        {[1, 2, 3, 4, 5].map((number) => (
          <button
            key={number}
            type="button"
            onClick={() => onChange(number)}
            className="rounded-lg p-1 transition-transform hover:scale-110 focus:outline-none"
            aria-label={`${number} نجوم`}
          >
            <Star
              size={25}
              fill={number <= value ? "currentColor" : "none"}
              className={
                number <= value
                  ? "text-amber-400"
                  : "text-slate-200"
              }
            />
          </button>
        ))}
      </div>
    );
  }

  const incomingCount = requests.filter(
    (request) => request.seller_id === userId
  ).length;

  const outgoingCount = requests.filter(
    (request) => request.buyer_id === userId
  ).length;

  const visibleRequests = requests.filter((request) =>
    activeTab === "incoming"
      ? request.seller_id === userId
      : request.buyer_id === userId
  );

  if (loading) {
    return (
      <div
        dir="rtl"
        className="flex min-h-screen items-center justify-center bg-[#f7f9f8] px-4"
      >
        <div className="flex flex-col items-center gap-4">
          <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50">
            <RefreshCw
              size={25}
              className="animate-spin text-emerald-600"
            />
          </div>
          <p className="text-sm font-bold text-slate-500">
            جارٍ تحميل طلبات البيع والشراء...
          </p>
        </div>
      </div>
    );
  }

  if (!userId) {
    return (
      <main
        dir="rtl"
        className="flex min-h-screen items-center justify-center bg-[#f7f9f8] p-5"
      >
        <div className="w-full max-w-md rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm">
          <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
            <UserRound size={30} />
          </div>

          <h2 className="mb-2 text-lg font-black text-slate-800">
            سجّل دخولك أولاً
          </h2>

          <p className="mb-6 text-sm leading-7 text-slate-500">
            يرجى تسجيل الدخول إلى حسابك حتى تتمكن من متابعة طلبات البيع والشراء.
          </p>

          <Link
            to="/auth"
            className="inline-flex w-full items-center justify-center rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700"
          >
            تسجيل الدخول
          </Link>
        </div>
      </main>
    );
  }

  return (
    <main
      dir="rtl"
      className="min-h-screen bg-[#f7f9f8] pb-10 text-slate-800"
    >
      <header className="sticky top-0 z-30 border-b border-slate-100/80 bg-white/95 backdrop-blur-md">
        <div className="mx-auto flex max-w-4xl items-center gap-3 px-4 py-3.5">
          <Link
            to="/profile"
            className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-50 text-slate-600 transition hover:bg-emerald-50 hover:text-emerald-700"
            aria-label="العودة إلى الملف الشخصي"
          >
            <ArrowRight size={20} />
          </Link>

          <div className="min-w-0">
            <h1 className="text-base font-black text-slate-800 sm:text-lg">
              طلبات البيع والشراء
            </h1>
            <p className="mt-0.5 text-[11px] text-slate-400 sm:text-xs">
              تابع طلباتك وأدر عمليات البيع بسهولة
            </p>
          </div>

          <button
            onClick={loadRequests}
            disabled={loading}
            className="mr-auto flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-100 bg-white text-slate-500 transition hover:border-emerald-100 hover:bg-emerald-50 hover:text-emerald-700 disabled:opacity-50"
            aria-label="تحديث الطلبات"
            title="تحديث الطلبات"
          >
            <RefreshCw size={18} />
          </button>
        </div>
      </header>

      <div className="mx-auto max-w-4xl space-y-5 px-4 py-6 sm:py-8">
        <section className="relative overflow-hidden rounded-3xl bg-gradient-to-l from-emerald-700 to-emerald-600 p-5 text-white shadow-sm sm:p-6">
          <div className="pointer-events-none absolute -left-10 -top-16 h-44 w-44 rounded-full bg-white/10" />
          <div className="pointer-events-none absolute -bottom-20 right-1/3 h-48 w-48 rounded-full bg-white/5" />

          <div className="relative flex items-center justify-between gap-4">
            <div>
              <div className="mb-2 flex items-center gap-2 text-emerald-100">
                <ShoppingBag size={17} />
                <span className="text-xs font-semibold">
                  مساحة معاملاتك
                </span>
              </div>

              <h2 className="text-xl font-black sm:text-2xl">
                بيع وشراء بكل سهولة
              </h2>

              <p className="mt-2 max-w-sm text-xs leading-6 text-emerald-50 sm:text-sm">
                جميع طلباتك ومعاملاتك في مكان واحد، مع متابعة واضحة لكل خطوة.
              </p>
            </div>

            <div className="hidden h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-white/20 bg-white/10 sm:flex">
              <PackageCheck size={34} className="text-white" />
            </div>
          </div>

          <div className="relative mt-5 grid grid-cols-2 gap-3">
            <div className="rounded-2xl border border-white/15 bg-white/10 p-3">
              <p className="text-[11px] text-emerald-100">
                الطلبات الواردة
              </p>
              <p className="mt-1 text-2xl font-black tabular-nums">
                {incomingCount}
              </p>
            </div>

            <div className="rounded-2xl border border-white/15 bg-white/10 p-3">
              <p className="text-[11px] text-emerald-100">
                طلبات الشراء
              </p>
              <p className="mt-1 text-2xl font-black tabular-nums">
                {outgoingCount}
              </p>
            </div>
          </div>
        </section>

        <section className="rounded-2xl border border-slate-100 bg-white p-1.5 shadow-sm">
          <div className="grid grid-cols-2 gap-1.5">
            <button
              onClick={() => setActiveTab("incoming")}
              className={`relative flex min-h-12 items-center justify-center gap-2 rounded-xl px-3 py-3 text-sm font-bold transition-all ${
                activeTab === "incoming"
                  ? "bg-emerald-600 text-white shadow-sm"
                  : "text-slate-500 hover:bg-slate-50 hover:text-slate-700"
              }`}
            >
              <ShoppingBag size={17} />
              <span>طلبات واردة</span>
              <span
                className={`min-w-5 rounded-full px-1.5 py-0.5 text-[10px] tabular-nums ${
                  activeTab === "incoming"
                    ? "bg-white/20 text-white"
                    : "bg-slate-100 text-slate-500"
                }`}
              >
                {incomingCount}
              </span>
            </button>

            <button
              onClick={() => setActiveTab("outgoing")}
              className={`relative flex min-h-12 items-center justify-center gap-2 rounded-xl px-3 py-3 text-sm font-bold transition-all ${
                activeTab === "outgoing"
                  ? "bg-emerald-600 text-white shadow-sm"
                  : "text-slate-500 hover:bg-slate-50 hover:text-slate-700"
              }`}
            >
              <Clock size={17} />
              <span>طلباتي</span>
              <span
                className={`min-w-5 rounded-full px-1.5 py-0.5 text-[10px] tabular-nums ${
                  activeTab === "outgoing"
                    ? "bg-white/20 text-white"
                    : "bg-slate-100 text-slate-500"
                }`}
              >
                {outgoingCount}
              </span>
            </button>
          </div>
        </section>

        {message && (
          <div className="flex items-start gap-3 rounded-2xl border border-rose-100 bg-rose-50 p-4 text-sm leading-6 text-rose-700">
            <XCircle size={19} className="mt-0.5 shrink-0" />
            <p className="font-semibold">{message}</p>
          </div>
        )}

        <div className="flex items-center justify-between px-1">
          <div>
            <h2 className="text-base font-black text-slate-800">
              {activeTab === "incoming"
                ? "الطلبات الواردة إليك"
                : "طلبات الشراء الخاصة بك"}
            </h2>
            <p className="mt-1 text-xs text-slate-400">
              {visibleRequests.length === 0
                ? "لا توجد معاملات حالياً"
                : `${visibleRequests.length} طلب`}
            </p>
          </div>
        </div>

        {visibleRequests.length === 0 ? (
          <div className="rounded-3xl border border-slate-100 bg-white px-5 py-12 text-center shadow-sm">
            <div className="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-3xl bg-slate-50 text-slate-300">
              {activeTab === "incoming" ? (
                <ShoppingBag size={35} strokeWidth={1.6} />
              ) : (
                <Clock size={35} strokeWidth={1.6} />
              )}
            </div>

            <h3 className="text-base font-black text-slate-700">
              لا توجد طلبات هنا بعد
            </h3>

            <p className="mx-auto mt-2 max-w-xs text-sm leading-7 text-slate-400">
              {activeTab === "incoming"
                ? "عندما يرسل أحد المستخدمين طلب شراء لأحد إعلاناتك، سيظهر هنا."
                : "عندما ترسل طلب شراء لأحد الإعلانات، ستتمكن من متابعة حالته من هنا."}
            </p>

            <Link
              to="/"
              className="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-50 px-5 py-3 text-sm font-bold text-emerald-700 transition hover:bg-emerald-100"
            >
              تصفح الإعلانات
              <ChevronLeft size={17} />
            </Link>
          </div>
        ) : (
          <div className="space-y-4">
            {visibleRequests.map((request) => {
              const isSeller = request.seller_id === userId;
              const alreadyReviewed = request.already_reviewed;
              const deliveryRecord = deliveryRecords.find(
                (item) => item.request.sale_request_id === request.id
              );
              const deliveryStatus = deliveryRecord?.request.status;
              const deliveryAlreadySubmitted = !!deliveryRecord && [
                "pending_driver", "accepted", "waiting_price",
                "waiting_buyer_approval", "agreed", "picked_up",
                "on_the_way", "awaiting_buyer_payment",
                "return_required", "returning"
              ].includes(deliveryStatus || "");
              const pendingDeliveryPrice = deliveryRecord?.price_history
                ?.filter((price) => price.status === "pending")
                .slice(-1)[0];

              return (
                <article
                  id={`sale-request-${request.id}`}
                  key={request.id}
                  className={`overflow-hidden rounded-3xl border bg-white shadow-sm transition-all duration-300 hover:shadow-md ${
                    targetRequestId === request.id
                      ? "border-emerald-400 ring-4 ring-emerald-100"
                      : "border-slate-100"
                  }`}
                >
                  <div className="space-y-4 p-4 sm:p-5">
                    <div className="flex items-start justify-between gap-3">
                      <div className="flex min-w-0 items-start gap-3">
                        <div className="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-emerald-50 text-emerald-700">
                          {request.other_avatar ? (
                            <img
                              src={request.other_avatar}
                              alt={request.other_name || "المستخدم"}
                              className="h-full w-full object-cover"
                            />
                          ) : (
                            <UserRound size={21} />
                          )}
                        </div>

                        <div className="min-w-0 pt-0.5">
                          <h3 className="line-clamp-2 text-sm font-black leading-6 text-slate-800 sm:text-base">
                            {request.ad_title}
                          </h3>

                          <p className="mt-1 text-xs text-slate-500">
                            {isSeller ? "المشتري: " : "البائع: "}
                            <span className="font-bold text-slate-700">
                              {request.other_name}
                            </span>
                          </p>
                        </div>
                      </div>

                      <span
                        className={`inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[10px] font-bold sm:text-xs ${statusColor(
                          request.status
                        )}`}
                      >
                        {statusIcon(request.status)}
                        {statusLabel(request.status)}
                      </span>
                    </div>

                    <div className="grid grid-cols-2 gap-2">
                      <div className="rounded-2xl bg-slate-50 p-3">
                        <div className="flex items-center gap-1.5 text-[11px] text-slate-400">
                          <Tag size={13} />
                          السعر المتفق عليه
                        </div>

                        <p className="mt-1.5 text-base font-black text-emerald-700 sm:text-lg">
                          {Number(request.agreed_price).toLocaleString("en-US")}
                          <span className="mr-1 text-[11px] font-bold text-slate-500">
                            {request.currency === "USD"
                              ? "دولار"
                              : "ليرة سورية"}
                          </span>
                        </p>
                      </div>

                      <div className="rounded-2xl bg-slate-50 p-3">
                        <div className="flex items-center gap-1.5 text-[11px] text-slate-400">
                          <CalendarDays size={13} />
                          تاريخ الطلب
                        </div>

                        <p className="mt-2 text-xs font-bold text-slate-700 sm:text-sm">
                          {new Date(request.created_at).toLocaleDateString(
                            "ar-SY"
                          )}
                        </p>
                      </div>
                    </div>

                    <div className="flex flex-wrap gap-2">
                      {request.public_code && (
                        <Link
                          to={`/ad/${request.public_code}`}
                          className="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700"
                        >
                          <ShoppingBag size={15} />
                          عرض الإعلان
                        </Link>
                      )}

                      {request.conversation_id && (
                        <Link
                          to={`/messages/${request.conversation_id}`}
                          className="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-emerald-100 bg-emerald-50/60 px-3 py-2 text-xs font-bold text-emerald-700 transition hover:bg-emerald-100"
                        >
                          <MessageCircle size={15} />
                          المحادثة
                        </Link>
                      )}
                    </div>

                    {isSeller && request.status === "pending" && (
                      <div className="grid grid-cols-2 gap-2.5 border-t border-slate-100 pt-4">
                        <button
                          onClick={() => runAction(request.id, "accept")}
                          disabled={actionLoading === request.id}
                          className="flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-3 py-2.5 text-xs font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm"
                        >
                          <CheckCircle size={17} />
                          قبول الطلب
                        </button>

                        <button
                          onClick={() => runAction(request.id, "reject")}
                          disabled={actionLoading === request.id}
                          className="flex min-h-11 items-center justify-center gap-2 rounded-xl border border-rose-100 bg-rose-50 px-3 py-2.5 text-xs font-bold text-rose-600 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm"
                        >
                          <XCircle size={17} />
                          رفض الطلب
                        </button>
                      </div>
                    )}

                    {isSeller && request.status === "accepted" && (
                      <div className="border-t border-slate-100 pt-4">
                        <button
                          onClick={() => runAction(request.id, "delivered")}
                          disabled={actionLoading === request.id}
                          className="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                        >
                          <PackageCheck size={19} />
                          تم تسليم السلعة للمشتري
                        </button>
                      </div>
                    )}

                    {!isSeller &&
                      request.status === "accepted" &&
                      !deliveryAlreadySubmitted && (
                        <div className="border-t border-slate-100 pt-4">
                          <button
                            onClick={() => setDeliveryRequest(request)}
                            className="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-emerald-700"
                          >
                            <Truck size={19} />
                            اطلب توصيل السلعة
                          </button>
                          <p className="mt-2 text-center text-xs leading-5 text-slate-400">
                            اختر مدينة وموقع التسليم وعامل التوصيل المناسب.
                          </p>
                        </div>
                      )}

                    {!isSeller && deliveryRecord && (
                      <div className="space-y-3 rounded-2xl border border-sky-100 bg-sky-50 p-4">
                        <p className="text-sm font-black text-slate-800">حالة طلب التوصيل</p>
                        <p className="text-sm text-slate-600">
                          {deliveryStatus === "pending_driver" ? "بانتظار رد عامل التوصيل" :
                           deliveryStatus === "waiting_buyer_approval" ? "أرسل العامل أجرة التوصيل، بانتظار موافقتك" :
                           deliveryStatus === "agreed" ? "تم الاتفاق على أجرة التوصيل" :
                           deliveryStatus === "picked_up" ? "استلم العامل السلعة" :
                           deliveryStatus === "on_the_way" ? "الطلب في الطريق" :
                           deliveryStatus === "delivered" ? "تم تسليم السلعة" :
                           deliveryStatus === "cancelled" ? "تم إلغاء الطلب" :
                           deliveryStatus === "expired" ? "انتهت مهلة الطلب" : "طلب التوصيل قيد المعالجة"}
                        </p>
                        {pendingDeliveryPrice && (
                          <div className="rounded-xl border border-amber-200 bg-amber-50 p-3">
                            <p className="text-sm font-bold text-amber-900">أجرة التوصيل المقترحة</p>
                            <p className="mt-1 text-xl font-black text-slate-900">
                              {Number(pendingDeliveryPrice.amount).toLocaleString("ar-SY")} {pendingDeliveryPrice.currency}
                            </p>
                            <div className="mt-3 grid grid-cols-2 gap-2">
                              <button
                                onClick={() => respondToDeliveryPrice(deliveryRecord.request.id, true)}
                                disabled={!!actionLoading}
                                className="rounded-xl bg-emerald-600 px-3 py-3 text-sm font-bold text-white disabled:opacity-50"
                              >
                                موافقة
                              </button>
                              <button
                                onClick={() => respondToDeliveryPrice(deliveryRecord.request.id, false)}
                                disabled={!!actionLoading}
                                className="rounded-xl bg-rose-600 px-3 py-3 text-sm font-bold text-white disabled:opacity-50"
                              >
                                رفض الأجرة
                              </button>
                            </div>
                          </div>
                        )}
                        {deliveryStatus === "agreed" && deliveryRecord.request.delivery_fee != null && (
                          <p className="font-bold text-emerald-700">
                            الأجرة المتفق عليها: {Number(deliveryRecord.request.delivery_fee).toLocaleString("ar-SY")} {deliveryRecord.request.item_currency}
                          </p>
                        )}
                      </div>
                    )}

                    {!isSeller && request.status === "seller_marked_sold" && (
                      <div className="border-t border-slate-100 pt-4">
                        <button
                          onClick={() => runAction(request.id, "received")}
                          disabled={actionLoading === request.id}
                          className="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                        >
                          <CheckCircle size={19} />
                          أؤكد استلام السلعة
                        </button>
                      </div>
                    )}

                    {!isSeller &&
                      request.status === "completed" &&
                      !alreadyReviewed && (
                        <div className="border-t border-slate-100 pt-4">
                          <button
                            onClick={() => setReviewRequest(request)}
                            className="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-3 text-sm font-bold text-white transition hover:bg-amber-600"
                          >
                            <Star size={19} />
                            قيّم البائع
                          </button>
                        </div>
                      )}

                    {!isSeller &&
                      request.status === "completed" &&
                      alreadyReviewed && (
                        <div className="flex items-center gap-2 rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-xs font-bold text-emerald-700">
                          <CheckCircle size={17} />
                          تم إرسال تقييمك لهذا البيع، شكراً لمشاركتك.
                        </div>
                      )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>

      {reviewRequest && (
        <div
          className="fixed inset-0 z-50 flex items-end justify-center overflow-y-auto bg-slate-950/50 p-0 backdrop-blur-sm sm:items-center sm:p-4"
          onClick={(event) => {
            if (event.target === event.currentTarget) {
              setReviewRequest(null);
            }
          }}
        >
          <div className="my-auto max-h-[92vh] w-full max-w-lg space-y-5 overflow-y-auto rounded-t-3xl border border-slate-100 bg-white p-5 shadow-2xl sm:rounded-3xl sm:p-6">
            <div className="flex items-center justify-between border-b border-slate-100 pb-4">
              <div>
                <h2 className="text-lg font-black text-slate-800">
                  تقييم البائع
                </h2>
                <p className="mt-1 text-xs text-slate-400">
                  شارك تجربتك وساعد الآخرين في اتخاذ القرار
                </p>
              </div>

              <button
                onClick={() => setReviewRequest(null)}
                className="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-50 text-slate-500 transition hover:bg-rose-50 hover:text-rose-600"
                aria-label="إغلاق"
              >
                <XCircle size={21} />
              </button>
            </div>

            <div className="rounded-2xl bg-emerald-50/70 p-3">
              <p className="text-xs text-emerald-700">تقييمك للبائع</p>
              <p className="mt-1 text-sm font-black text-slate-800">
                {reviewRequest.other_name}
              </p>
            </div>

            <div className="space-y-4">
              <div className="flex items-center justify-between gap-3">
                <p className="text-sm font-bold text-slate-700">
                  التقييم العام
                </p>
                {renderStars(rating, setRating)}
              </div>

              <div className="h-px bg-slate-100" />

              <div className="flex items-center justify-between gap-3">
                <p className="text-sm font-semibold text-slate-600">
                  التواصل
                </p>
                {renderStars(
                  communicationRating,
                  setCommunicationRating
                )}
              </div>

              <div className="h-px bg-slate-100" />

              <div className="flex items-center justify-between gap-3">
                <p className="text-sm font-semibold text-slate-600">
                  مصداقية البائع
                </p>
                {renderStars(
                  credibilityRating,
                  setCredibilityRating
                )}
              </div>

              <div className="h-px bg-slate-100" />

              <div className="flex items-center justify-between gap-3">
                <p className="text-sm font-semibold text-slate-600">
                  مطابقة السلعة للوصف
                </p>
                {renderStars(
                  descriptionRating,
                  setDescriptionRating
                )}
              </div>

              <div className="h-px bg-slate-100" />

              <div className="flex items-center justify-between gap-3">
                <p className="text-sm font-semibold text-slate-600">
                  التعامل والسلوك
                </p>
                {renderStars(behaviorRating, setBehaviorRating)}
              </div>
            </div>

            <div>
              <label className="mb-2 block text-sm font-bold text-slate-700">
                تعليقك
                <span className="mr-1 font-normal text-slate-400">
                  (اختياري)
                </span>
              </label>

              <textarea
                value={reviewComment}
                onChange={(event) => setReviewComment(event.target.value)}
                maxLength={1000}
                rows={3}
                placeholder="شارك تجربتك مع البائع..."
                className="w-full resize-none rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-50"
              />

              <p className="mt-1.5 text-left text-[10px] text-slate-400">
                {reviewComment.length}/1000
              </p>
            </div>

            <div className="grid grid-cols-2 gap-2.5 pt-1">
              <button
                onClick={submitReview}
                disabled={actionLoading === reviewRequest.id}
                className="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {actionLoading === reviewRequest.id ? (
                  <>
                    <RefreshCw size={17} className="animate-spin" />
                    جارٍ الإرسال...
                  </>
                ) : (
                  <>
                    <Star size={17} />
                    إرسال التقييم
                  </>
                )}
              </button>

              <button
                onClick={() => setReviewRequest(null)}
                disabled={actionLoading === reviewRequest.id}
                className="min-h-12 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50 disabled:opacity-50"
              >
                إلغاء
              </button>
            </div>
          </div>
        </div>
      )}

      {deliveryRequest && (
        <DeliveryRequestModal
          saleRequestId={deliveryRequest.id}
          onClose={() => setDeliveryRequest(null)}
          onSuccess={() => {
            setDeliveryRequest(null);
            setMessage("");
            void loadRequests();
          }}
        />
      )}
    </main>
  );
}
